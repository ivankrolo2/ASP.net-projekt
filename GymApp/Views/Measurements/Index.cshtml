@model IEnumerable<BodyMeasurement>

@{
    ViewData["Title"] = "Mjerenja";
    var selected = ViewData["SelectedFilter"]?.ToString() ?? "all";
}

<section class="page-panel">
    <h1 class="page-title">Mjerenja</h1>
    <p class="page-subtitle">Promjene tezine i body-fat postotka kroz vrijeme.</p>

    <div class="chip-row filter-row">
        <a class="chip-link @(selected == "all" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-user="all">Svi korisnici</a>
        <a class="chip-link @(selected == "ivan" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-user="ivan">Ivan</a>
        <a class="chip-link @(selected == "petra" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-user="petra">Petra</a>
        <a class="chip-link @(selected == "luka" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-user="luka">Luka</a>
    </div>

    <div class="row-list">
        @foreach (var measurement in Model)
        {
            <a class="data-row" asp-action="Details" asp-route-id="@measurement.Id">
                <div>
                    <p class="data-title">@measurement.User?.FirstName @measurement.User?.LastName</p>
                    <p class="data-subtitle">@measurement.RecordedAt.ToString("dd.MM.yyyy")</p>
                </div>
                <div class="data-tags">
                    <span class="tag">@measurement.BodyWeightKg.ToString("F1") kg</span>
                    <span class="tag">@measurement.BodyFatPercentage.ToString("F1")% BF</span>
                </div>
            </a>
        }
    </div>
</section>
