@model BodyMeasurement

@{
    ViewData["Title"] = ViewData["PageTitle"] ?? "Uredi mjerenje";
}

<section class="page-panel">
    <h1 class="page-title">@ViewData["PageTitle"]</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3 autocomplete">
            <label asp-for="UserId" class="form-label">Korisnik</label>
            <input class="form-control"
                   type="text"
                   placeholder="Pretrazi korisnike"
                   value="@Model.User?.FirstName @Model.User?.LastName"
                   data-autocomplete-input
                   data-autocomplete-url="@Url.Action("Autocomplete", "Users")"
                   data-autocomplete-target="UserId" />
            <input asp-for="UserId" type="hidden" id="UserId" class="validate-hidden" />
            <div class="autocomplete-menu" data-autocomplete-menu></div>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" for="RecordedAt_display">@Html.DisplayNameFor(m => m.RecordedAt)</label>
            @Html.EditorFor(m => m.RecordedAt, "DateTime")
            <span asp-validation-for="RecordedAt" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BodyWeightKg" class="form-label"></label>
            <input asp-for="BodyWeightKg" class="form-control" type="number" step="0.1" min="0" />
            <span asp-validation-for="BodyWeightKg" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BodyFatPercentage" class="form-label"></label>
            <input asp-for="BodyFatPercentage" class="form-control" type="number" step="0.1" min="0" />
            <span asp-validation-for="BodyFatPercentage" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-theme-primary">Spremi</button>
            <a class="btn-theme-secondary" asp-action="Details" asp-route-id="@Model.Id">Odustani</a>
        </div>
    </form>
</section>
