@model BodyMeasurement

@{
    ViewData["Title"] = "Obrisi mjerenje";
}

<section class="detail-shell">
    <header class="detail-header">
        <h1>Obrisi mjerenje</h1>
        <a class="btn-theme-secondary" asp-action="Index">Natrag na listu</a>
    </header>

    <div class="detail-grid single-col">
        <article class="surface-panel">
            <h2>@Model.User?.FirstName @Model.User?.LastName</h2>
            <p>Datum: @Model.RecordedAt.ToString("dd.MM.yyyy")</p>
            <p>Tezina: @Model.BodyWeightKg.ToString("F1") kg</p>
            <p class="text-muted">Potvrdi brisanje ovog mjerenja.</p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
                <button type="submit" class="btn-theme-primary">Obrisi</button>
                <a class="btn-theme-secondary" asp-action="Details" asp-route-id="@Model.Id">Odustani</a>
            </form>
        </article>
    </div>
</section>
