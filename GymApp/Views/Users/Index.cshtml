@model IEnumerable<UserProfile>

@{
    ViewData["Title"] = "Korisnici";
    var selected = ViewData["SelectedFilter"]?.ToString() ?? "all";
}

<section class="page-panel">
    <h1 class="page-title">Korisnici</h1>
    <p class="page-subtitle">Upravljanje profilima i prikaz aktivnosti korisnika.</p>

    <div class="d-flex align-items-center justify-content-between mt-3">
        <div class="chip-row filter-row">
            <a class="chip-link @(selected == "all" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-activity="all">Svi</a>
            <a class="chip-link @(selected == "high" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-activity="high">2+ treninga</a>
            <a class="chip-link @(selected == "low" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-activity="low">0-1 trening</a>
        </div>
        <a class="btn-theme-primary" asp-action="Create">+ Novi korisnik</a>
    </div>

    <div class="search-row">
        <input class="search-input"
               type="search"
               name="q"
               placeholder="Pretrazi korisnike"
               value="@ViewData["Search"]"
               data-search-input
               data-search-url="@Url.Action("Search", "Users")"
               data-search-target="userList"
               data-filter-name="activity"
               data-filter-value="@selected" />
    </div>

    <div id="userList">
        @await Html.PartialAsync("_List", Model)
    </div>
</section>
