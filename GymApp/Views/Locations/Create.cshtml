@model GymLocation

@{
    ViewData["Title"] = ViewData["PageTitle"] ?? "Nova lokacija";
}

<section class="page-panel">
    <h1 class="page-title">@ViewData["PageTitle"]</h1>

    <form asp-action="Create" method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Capacity" class="form-label"></label>
            <input asp-for="Capacity" class="form-control" type="number" min="0" />
            <span asp-validation-for="Capacity" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-theme-primary">Spremi</button>
            <a class="btn-theme-secondary" asp-action="Index">Odustani</a>
        </div>
    </form>
</section>
