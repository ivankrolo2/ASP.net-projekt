@model IEnumerable<GymApp.Models.Coach>

@{
    ViewData["Title"] = ViewData["PageTitle"] ?? "Treneri";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="page-title">@ViewData["PageTitle"]</h2>
    <a class="btn-theme-primary" asp-controller="Coaches" asp-action="Create">+ Novi trener</a>
</div>

<div class="search-row">
    <input class="search-input"
           type="search"
           name="q"
           placeholder="Pretrazi trenere"
           value="@ViewData["Search"]"
           data-search-input
           data-search-url="@Url.Action("Search", "Coaches")"
           data-search-target="coachList" />
</div>

<div id="coachList">
    @await Html.PartialAsync("_List", Model)
</div>
