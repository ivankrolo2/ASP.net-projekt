@model IEnumerable<WorkoutSession>

@{
    ViewData["Title"] = "Treninzi";
    var selected = ViewData["SelectedFilter"]?.ToString() ?? "all";
}

<section class="page-panel">
    <h1 class="page-title">Treninzi</h1>
    <p class="page-subtitle">Pregled odradenih sesija, trajanja, volumena i dojmova.</p>

    <div class="chip-row filter-row">
        <a class="chip-link @(selected == "all" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-month="all">Svi</a>
        <a class="chip-link @(selected == "early" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-month="early">1.-7. dan</a>
        <a class="chip-link @(selected == "late" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-month="late">8.+ dan</a>
    </div>

    <div class="row-list">
        @foreach (var session in Model)
        {
            <a class="data-row" asp-action="Details" asp-route-id="@session.Id">
                <div>
                    <p class="data-title">@session.User?.FirstName @session.User?.LastName</p>
                    <p class="data-subtitle">@session.Program?.Name • @session.SessionDate.ToString("dd.MM.yyyy")</p>
                </div>
                <div class="data-tags">
                    <span class="tag">@session.DurationMinutes min</span>
                    <span class="tag">@session.TotalVolumeKg.ToString("F1") kg</span>
                </div>
            </a>
        }
    </div>
</section>
