@model WorkoutSession

@{
    ViewData["Title"] = ViewData["PageTitle"] ?? "Novi trening";
    var programs = (SelectList)ViewData["Programs"]!;
}

<section class="page-panel">
    <h1 class="page-title">@ViewData["PageTitle"]</h1>

    <form asp-action="Create" method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3 autocomplete">
            <label asp-for="UserId" class="form-label">Korisnik</label>
            <input class="form-control"
                   type="text"
                   placeholder="Pretrazi korisnike"
                   data-autocomplete-input
                   data-autocomplete-url="@Url.Action("Autocomplete", "Users")"
                   data-autocomplete-target="UserId" />
            <input asp-for="UserId" type="hidden" id="UserId" class="validate-hidden" />
            <div class="autocomplete-menu" data-autocomplete-menu></div>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ProgramId" class="form-label">Program</label>
            <select asp-for="ProgramId" asp-items="programs" class="form-select">
                <option value="">(Bez programa)</option>
            </select>
            <span asp-validation-for="ProgramId" class="text-danger"></span>
        </div>

        <div class="mb-3 autocomplete">
            <label asp-for="GymLocationId" class="form-label">Lokacija</label>
            <input class="form-control"
                   type="text"
                   placeholder="Pretrazi lokacije"
                   data-autocomplete-input
                   data-autocomplete-url="@Url.Action("Autocomplete", "Locations")"
                   data-autocomplete-target="GymLocationId" />
            <input asp-for="GymLocationId" type="hidden" id="GymLocationId" />
            <div class="autocomplete-menu" data-autocomplete-menu></div>
            <span asp-validation-for="GymLocationId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" for="SessionDate_display">@Html.DisplayNameFor(m => m.SessionDate)</label>
            @Html.EditorFor(m => m.SessionDate, "DateTime")
            <span asp-validation-for="SessionDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DurationMinutes" class="form-label"></label>
            <input asp-for="DurationMinutes" class="form-control" type="number" min="0" />
            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Rating" class="form-label"></label>
            <input asp-for="Rating" class="form-control" type="number" min="0" max="5" />
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TotalVolumeKg" class="form-label"></label>
            <input asp-for="TotalVolumeKg" class="form-control" type="number" step="0.1" min="0" />
            <span asp-validation-for="TotalVolumeKg" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-theme-primary">Spremi</button>
            <a class="btn-theme-secondary" asp-action="Index">Odustani</a>
        </div>
    </form>
</section>
