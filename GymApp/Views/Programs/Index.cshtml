@model IEnumerable<TrainingProgram>

@{
    ViewData["Title"] = "Programi";
    var selected = ViewData["SelectedFilter"]?.ToString() ?? "all";
}

<section class="page-panel">
    <h1 class="page-title">Programi</h1>
    <p class="page-subtitle">Planovi treninga s ciljem, tezinskim nivoom i trenerom.</p>

    <div class="chip-row filter-row">
        <a class="chip-link @(selected == "all" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-difficulty="all">Svi</a>
        <a class="chip-link @(selected == "easy" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-difficulty="easy">Easy</a>
        <a class="chip-link @(selected == "medium" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-difficulty="medium">Medium</a>
        <a class="chip-link @(selected == "hard" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-difficulty="hard">Hard</a>
    </div>

    <div class="row-list">
        @foreach (var program in Model)
        {
            <a class="data-row" asp-action="Details" asp-route-id="@program.Id">
                <div>
                    <p class="data-title">@program.Name</p>
                    <p class="data-subtitle">@program.Goal</p>
                </div>
                <div class="data-tags">
                    <span class="tag">@program.Weeks tjedana</span>
                    <span class="tag">@program.Difficulty</span>
                </div>
            </a>
        }
    </div>
</section>
