@model TrainingProgram

@{
    ViewData["Title"] = "Detalji programa";
}

<section class="detail-shell">
    <header class="detail-header">
        <h1>@Model.Name</h1>
        <div class="d-flex gap-2">
            <a class="btn-theme-secondary" asp-action="Index">Natrag na listu</a>
            <a class="btn-theme-primary" asp-action="Edit" asp-route-id="@Model.Id">Uredi</a>
            <a class="btn-theme-secondary" asp-action="Delete" asp-route-id="@Model.Id">Obrisi</a>
        </div>
    </header>

    <div class="detail-grid">
        <article class="surface-panel">
            <h2>Program</h2>
            <p>Cilj: @Model.Goal</p>
            <p>Trajanje: @Model.Weeks tjedana</p>
            <p>Difficulty: @Model.Difficulty</p>
            <p>Coach: @Model.CoachName</p>
        </article>
        <article class="surface-panel">
            <h2>Vjezbe</h2>
            @foreach (var pe in Model.ProgramExercises)
            {
                <div class="mini-row">
                    <span>@pe.Exercise?.Name</span>
                    <span>@pe.TargetSets x @pe.TargetReps</span>
                </div>
            }
        </article>
    </div>
</section>
