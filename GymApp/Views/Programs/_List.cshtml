@model IEnumerable<TrainingProgram>

@if (!Model.Any())
{
    <p class="text-muted">Nema programa za zadani filter.</p>
}
else
{
    <div class="row-list">
        @foreach (var program in Model)
        {
            <div class="data-row">
                <div>
                    <p class="data-title">
                        <a class="data-link" asp-action="Details" asp-route-id="@program.Id">@program.Name</a>
                    </p>
                    <p class="data-subtitle">@program.Goal</p>
                </div>
                <div class="data-tags">
                    <span class="tag">@program.Weeks tjedana</span>
                    <span class="tag">@program.Difficulty</span>
                    <a class="action-link" asp-action="Edit" asp-route-id="@program.Id">Uredi</a>
                    <a class="action-link" asp-action="Delete" asp-route-id="@program.Id">Obrisi</a>
                </div>
            </div>
        }
    </div>
}
