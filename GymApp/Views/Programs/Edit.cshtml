@model TrainingProgram

@{
    ViewData["Title"] = ViewData["PageTitle"] ?? "Uredi program";
}

<section class="page-panel">
    <h1 class="page-title">@ViewData["PageTitle"]</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Goal" class="form-label"></label>
            <textarea asp-for="Goal" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Goal" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Weeks" class="form-label"></label>
            <input asp-for="Weeks" class="form-control" type="number" min="1" />
            <span asp-validation-for="Weeks" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Difficulty" class="form-label"></label>
            <select asp-for="Difficulty" asp-items="Html.GetEnumSelectList<WorkoutDifficulty>()" class="form-select"></select>
            <span asp-validation-for="Difficulty" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CoachName" class="form-label"></label>
            <input asp-for="CoachName" class="form-control" />
            <span asp-validation-for="CoachName" class="text-danger"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-theme-primary">Spremi</button>
            <a class="btn-theme-secondary" asp-action="Details" asp-route-id="@Model.Id">Odustani</a>
        </div>
    </form>
</section>
