@model Exercise

@{
    ViewData["Title"] = "Detalji vjezbe";
}

<section class="detail-shell">
    <header class="detail-header">
        <h1>@Model.Name</h1>
        <div class="d-flex gap-2">
            <a class="btn-theme-secondary" asp-action="Index">Natrag na listu</a>
            <a class="btn-theme-primary" asp-action="Edit" asp-route-id="@Model.Id">Uredi</a>
            <a class="btn-theme-secondary" asp-action="Delete" asp-route-id="@Model.Id">Obrisi</a>
        </div>
    </header>

    <div class="detail-grid">
        <article class="surface-panel">
            <h2>Opis</h2>
            <p>@Model.Description</p>
            <p>Kategorija: @Model.Category</p>
            <p>Primarna skupina: @Model.PrimaryMuscleGroup</p>
            <p>Oprema: @Model.Equipment</p>
        </article>
        <article class="surface-panel">
            <h2>Programska upotreba</h2>
            <p>Programskih veza: @Model.ProgramExercises.Count</p>
            <p>Tip: @(Model.IsCompound ? "Compound" : "Isolation")</p>
            <p>Kreirano: @Model.CreatedAt.ToString("dd.MM.yyyy")</p>
        </article>
    </div>
</section>
