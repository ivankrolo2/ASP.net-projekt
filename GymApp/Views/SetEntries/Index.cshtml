@model IEnumerable<SetEntry>

@{
    ViewData["Title"] = "Setovi";
    var selected = ViewData["SelectedFilter"]?.ToString() ?? "all";
}

<section class="page-panel">
    <h1 class="page-title">Set Entries</h1>
    <p class="page-subtitle">Detaljna evidencija svakog seta unutar sesije.</p>

    <div class="d-flex align-items-center justify-content-between mt-3">
        <div class="chip-row filter-row">
            <a class="chip-link @(selected == "all" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-exercise="all">Sve vjezbe</a>
            <a class="chip-link @(selected == "big3" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-exercise="big3">Big 3</a>
            <a class="chip-link @(selected == "bodyweight" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-exercise="bodyweight">Bodyweight</a>
        </div>
        <a class="btn-theme-primary" asp-action="Create">+ Novi set</a>
    </div>

    <div class="search-row">
        <input class="search-input"
               type="search"
               name="q"
               placeholder="Pretrazi setove"
               value="@ViewData["Search"]"
               data-search-input
               data-search-url="@Url.Action("Search", "SetEntries")"
               data-search-target="setEntryList"
               data-filter-name="exercise"
               data-filter-value="@selected" />
    </div>

    <div id="setEntryList">
        @await Html.PartialAsync("_List", Model)
    </div>
</section>
