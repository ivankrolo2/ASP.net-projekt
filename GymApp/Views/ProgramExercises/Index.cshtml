@model IEnumerable<ProgramExercise>

@{
    ViewData["Title"] = "Program vjezbe";
    var selected = ViewData["SelectedFilter"]?.ToString() ?? "all";
}

<section class="page-panel">
    <h1 class="page-title">Program vjezbe</h1>
    <p class="page-subtitle">Relacije izmedu programa i vjezbi po danima i ciljevima.</p>

    <div class="chip-row filter-row">
        <a class="chip-link @(selected == "all" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-day="all">Svi dani</a>
        <a class="chip-link @(selected == "d1" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-day="d1">Dan 1</a>
        <a class="chip-link @(selected == "d2" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-day="d2">Dan 2</a>
        <a class="chip-link @(selected == "d3" ? "chip-link-active" : string.Empty)" asp-action="Index" asp-route-day="d3">Dan 3</a>
    </div>

    <div class="row-list">
        @foreach (var relation in Model)
        {
            <a class="data-row" asp-action="Details" asp-route-id="@relation.Id">
                <div>
                    <p class="data-title">@relation.Program?.Name</p>
                    <p class="data-subtitle">Dan @relation.DayOfWeek • @relation.Exercise?.Name</p>
                </div>
                <div class="data-tags">
                    <span class="tag">@relation.TargetSets setova</span>
                    <span class="tag">@relation.TargetReps reps</span>
                </div>
            </a>
        }
    </div>
</section>
