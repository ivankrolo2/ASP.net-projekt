@model ProgramExercise

@{
    ViewData["Title"] = ViewData["PageTitle"] ?? "Uredi poveznicu";
    var programs = (SelectList)ViewData["Programs"]!;
    var exercises = (SelectList)ViewData["Exercises"]!;
}

<section class="page-panel">
    <h1 class="page-title">@ViewData["PageTitle"]</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="TrainingProgramId" class="form-label">Program</label>
            <select asp-for="TrainingProgramId" asp-items="programs" class="form-select"></select>
            <span asp-validation-for="TrainingProgramId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ExerciseId" class="form-label">Vjezba</label>
            <select asp-for="ExerciseId" asp-items="exercises" class="form-select"></select>
            <span asp-validation-for="ExerciseId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DayOfWeek" class="form-label">Dan u tjednu</label>
            <input asp-for="DayOfWeek" class="form-control" type="number" min="1" max="7" />
            <span asp-validation-for="DayOfWeek" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TargetSets" class="form-label"></label>
            <input asp-for="TargetSets" class="form-control" type="number" min="1" />
            <span asp-validation-for="TargetSets" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TargetReps" class="form-label"></label>
            <input asp-for="TargetReps" class="form-control" type="number" min="1" />
            <span asp-validation-for="TargetReps" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-theme-primary">Spremi</button>
            <a class="btn-theme-secondary" asp-action="Details" asp-route-id="@Model.Id">Odustani</a>
        </div>
    </form>
</section>
