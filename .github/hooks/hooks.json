{
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$payload = [Console]::In.ReadToEnd(); if (-not [string]::IsNullOrWhiteSpace($payload)) { Add-Content -Path '.github/hooks/agent_log.txt' -Value $payload -Encoding UTF8 }\""
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$payload = [Console]::In.ReadToEnd(); if (-not [string]::IsNullOrWhiteSpace($payload)) { Add-Content -Path '.github/hooks/agent_log.txt' -Value $payload -Encoding UTF8 }\""
      }
    ]
  }
}